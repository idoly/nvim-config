#!/usr/bin/env bash
set -euo pipefail
# cc-rs supplies Rust-style targets; Zig uses arch-os-abi without "unknown".
args=()
for arg in "$@"; do
  case "$arg" in
    --target=*-unknown-linux-*) arg="${arg/-unknown-linux-/-linux-}" ;;
    *-unknown-linux-*)
      if [[ ${#args[@]} -gt 0 && ${args[-1]} == -target ]]; then
        arg="${arg/-unknown-linux-/-linux-}"
      fi
      ;;
  esac
  args+=("$arg")
done
exec zig cc "${args[@]}"
